NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGO_URL=mongodb://localhost:27017/creative-hub
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=2592000

AWS_REGION=us-east-1
AWS_S3_BUCKET=change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
# Only set these for a non-AWS S3-compatible provider (Railway buckets, Cloudflare R2, MinIO).
# Leave both unset for real AWS S3. If AWS_REGION=auto, AWS_S3_ENDPOINT is required — the app
# refuses to start otherwise, since that combination always produces an unreachable hostname
# (the AWS SDK builds <bucket>.s3.auto.amazonaws.com, which doesn't exist).
# AWS_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_FORCE_PATH_STYLE=true

CORS_ORIGIN=http://localhost:5173

PREMBLY_API_URL=https://api.prembly.com
PREMBLY_API_KEY=change-me
PREMBLY_APP_ID=change-me
# Raise both in production — small values here favor fast local/test feedback over resilience.
KYC_JOB_ATTEMPTS=3
KYC_JOB_BACKOFF_MS=200

FLUTTERWAVE_API_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=change-me
FLUTTERWAVE_WEBHOOK_SECRET_HASH=change-me
PAYMENTS_JOB_ATTEMPTS=3
PAYMENTS_JOB_BACKOFF_MS=200
